---
import "../styles/editorial.css";
import "../styles/hero-static.css";
import ChatBot from "../components/ChatBot.astro";
import { SITE } from "../data/site";
import { PROJECTS, getFeaturedProjects } from "../data/projects";
import { SERVICIOS } from "../data/servicios";

const site = SITE;
const featured = getFeaturedProjects().slice(0, 6);

const FOLDER: Record<string,string> = {
  "merendero-lapuebla": "lapuebla",
  "txoko-kripan": "kripan",
  "apartamentos-labastida": "labastida",
};

const pick = (p: typeof featured[number], idx: number = 0) => {
  const raw = p.gallery[idx] ?? "";
  return raw.startsWith("/") ? raw : `/images/projects/${FOLDER[p.slug] ?? p.slug}/${raw}`;
};
const strip = (p: typeof featured[number], ext: string, idx: number = 0) => {
  const raw = p.gallery[idx] ?? "";
  return raw.replace(/\.[a-z0-9]+$/i, `.${ext}`);
};
const lapueblaFor = (arr: typeof featured) => arr.find(p => p.slug === "merendero-lapuebla")!;
const mariaImg = "/team/maria.jpg";
const servicios = SERVICIOS;
const year = new Date().getFullYear();
const telefono = SITE.phoneDisplay;
---

<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>mit interiorismo — De un espacio vacío a un hogar con alma · Yécora, Álava</title>
<meta name="description" content="Estudio boutique de interiorismo técnico en Yécora, Álava. María Iturbe Sánchez une diseño e ingeniería (CTE, REBT, RITE) en reformas integrales, cambio de uso y espacios comerciales en La Rioja y País Vasco." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter+Tight:wght@300;400;500;600&display=swap" rel="stylesheet" />
<meta property="og:title" content="mit interiorismo" />
<meta property="og:description" content="Donde el diseño encuentra a la obra" />
<meta property="og:image" content={`https://www.mitinteriorismo.studio${mariaImg}`} />
<!-- Chatbot data -->
<meta name="x-phone" content={SITE.phoneRaw} />
<meta name="x-email" content={SITE.email} />
<meta name="x-phone-display" content={SITE.phoneDisplay} />
<meta name="x-services" content={JSON.stringify(servicios.map(s => ({ id: s.id, title: s.title, subtitle: s.subtitle })))} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "mit interiorismo",
  "legalName": SITE.legalName,
  "description": site.tagline || site.shortDescription,
  "image": "https://www.mitinteriorismo.studio" + mariaImg,
  "url": "https://www.mitinteriorismo.studio",
  "telephone": SITE.phone,
  "email": SITE.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "postalCode": SITE.address.postalCode,
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.region,
    "addressCountry": SITE.address.country
  },
  "areaServed": ["Yécora", "Álava", "La Rioja", "Logroño", "Haro", "Vitoria", "País Vasco"],
  "priceRange": "€€"
})} />
</head>
<body>

<div class="prog" id="prog"></div>

<!-- nav principal -->
<header class="nav" id="nav">
  <a href="/" class="nav-mark">
    <span class="nav-mark-i">mit</span>
    <span class="nav-mark-s">Interiorismo · Yécora</span>
  </a>
  <nav class="nav-links">
    <a href="#proyectos" class="nav-l">Proyectos</a>
    <a href="#estudio" class="nav-l">Estudio</a>
    <a href="#servicios" class="nav-l">Servicios</a>
    <a href="#contacto" class="nav-l">Contacto</a>
  </nav>
</header>

<main id="main">

<!-- ===== HERO · DE UN ESPACIO VACÍO A UN HOGAR CON ALMA =====
     Imagen grande real del proyecto terminado de María.
     Hardcodeado: textos, copy, CTA fijos. Sin variables, sin CMS.
-->
<section class="hero-static" id="top" aria-label="Hero — MIT Interiorismo">

  <!-- Imagen de fondo: el espacio terminado (proyecto real de María) -->
  <picture class="hero-static-bg">
    <source srcset="/images/hero/04-espacio-terminado.avif" type="image/avif" />
    <source srcset="/images/hero/04-espacio-terminado.webp" type="image/webp" />
    <img
      src="/images/hero/04-espacio-terminado.jpg"
      alt="Reforma integral terminada — proyecto real de María Iturbe Sánchez en Yécora, Álava"
      class="hero-static-img"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="1920"
      height="1080"
    />
  </picture>

  <!-- Gradiente para legibilidad del texto -->
  <div class="hero-static-overlay" aria-hidden="true"></div>

  <!-- Contenido del hero -->
  <div class="hero-static-content">
    <p class="hero-static-kicker">Estudio de interiorismo · Yécora, Álava</p>

    <h1 class="hero-static-title">
      De un espacio vacío<br />
      a un hogar <em>con alma.</em>
    </h1>

    <p class="hero-static-lede">
      María une diseño e ingeniería —CTE, REBT, RITE— para entregar
      reformas habitables, normativas y con la luz bien puesta.
      Sobre La Rioja, Álava y País Vasco.
    </p>

    <div class="hero-static-actions">
      <a href="#proyectos" class="hs-cta hs-cta-primary">Ver proyectos</a>
      <a href="#contacto" class="hs-cta hs-cta-ghost">Empezar un proyecto</a>
    </div>
  </div>

  <!-- Indicador de scroll (estético, sin lógica) -->
  <div class="hero-static-scroll" aria-hidden="true">
    <span>Desplaza</span>
  </div>

</section>

<!-- ===== TICKER ===== -->
<section class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <span>Interiorismo técnico · Reforma · Cambio de uso · Asesoría · Render · Yécora · Logroño · Haro · Álava · Rioja · </span>
    <span>Interiorismo técnico · Reforma · Cambio de uso · Asesoría · Render · Yécora · Logroño · Haro · Álava · Rioja · </span>
  </div>
</section>

<!-- ===== MANIFIESTO ===== -->
<section class="manifest" id="manifiesto">
  <div class="manifest-grid">
    <aside class="manifest-meta">
      <p class="m-label">— Sobre el estudio</p>
      <p class="m-folio">Nº 01 · Manifiesto</p>
    </aside>
    <article class="manifest-body">
      <p class="manifest-q reveal">
        «No hacemos renders sin obra ni obras sin planos.
        Medimos la luz que entra, lo que cabe en la normativa,
        lo que aguanta el presupuesto. <em>El resto es vender humo.</em>»
      </p>
      <p class="manifest-sig">— María Iturbe Sánchez, ESDIR ’20 · nota 8,41</p>
    </article>
  </div>
</section>

<!-- ===== PROYECTOS ===== -->
<section class="works" id="proyectos">
  <header class="works-head">
    <div>
      <p class="kicker">02 · Trabajo seleccionado</p>
      <h2 class="display-2">
        <span>Pro</span><em>yec</em><span>tos</span>
      </h2>
    </div>
    <a href="/proyectos" class="all-link">Ver los 7 proyectos ↗</a>
  </header>

  {featured.map((p, i) => (
    <a href={`/proyectos/${p.slug}`} class={`work ${i % 2 === 1 ? 'work-rev' : ''}`}>
      <figure class="work-fig">
        <picture>
          <source srcset={strip(p, "avif", 0)} type="image/avif" />
          <source srcset={strip(p, "webp", 0)} type="image/webp" />
          <img src={pick(p, 0)} alt={p.title} loading={i < 2 ? "eager" : "lazy"} />
        </picture>
        <figcaption class="work-cap">
          <span>0{i+1} / 0{featured.length}</span>
          <span>{p.year} · {p.location || 'Yécora'}</span>
        </figcaption>
      </figure>
      <div class="work-info">
        <p class="work-cat">{p.type === 'residential' ? 'Residencial' : p.type === 'commercial' ? 'Comercial' : p.type === 'office' ? 'Oficina' : 'Espacio social'}</p>
        <h3 class="work-title">{p.title}</h3>
        <p class="work-desc">{p.subtitle || ''}</p>
        <span class="work-go">Ver proyecto →</span>
      </div>
    </a>
  ))}
</section>

<!-- ===== ESTUDIO ===== -->
<section class="estudio" id="estudio">
  <div class="est-grid">
    <figure class="est-fig">
      <picture>
        <source srcset="/team/maria.avif" type="image/avif" />
        <source srcset="/team/maria.webp" type="image/webp" />
        <img src="/team/maria.jpg" alt="María Iturbe Sánchez" loading="lazy" />
      </picture>
      <span class="est-fig-tag">María, 2024 · Yécora</span>
    </figure>
    <div class="est-body">
      <p class="kicker">03 · El estudio</p>
      <h2 class="display-2">
        <span>María</span> <em>Iturbe</em><br/>
        <span>Sánchez</span>
      </h2>
      <p class="est-lead">
        «Interiorista colegiada. 12 años en obra, 5 desde que abrió este estudio
        en un pueblo de 250 habitantes al sur de Álava.»
      </p>
      <p class="est-tx">
        Antes: Echazarreta Construcciones (Logroño), Blurarquitectura (Bilbao),
        COOK Cocina &amp; Baño. Hoy: dirección de proyectos residenciales,
        comerciales y de cambio de uso — con planos, normativa y obra alineados.
      </p>
      <ul class="est-tools">
        <li>AutoCAD</li><li>SketchUp · V-Ray 5</li><li>Presto</li>
        <li>Photoshop</li><li>InDesign</li><li>CTE · REBT · RITE</li>
      </ul>
      <a href="/sobre" class="btn-pri">Trayectoria completa →</a>
    </div>
  </div>
</section>

<!-- ===== SERVICIOS ===== -->
<section class="srv" id="servicios">
  <header class="srv-head">
    <div>
      <p class="kicker">04 · Ámbito</p>
      <h2 class="display-2"><span>Qué </span><em>hace</em><span> el estudio</span></h2>
    </div>
    <p class="srv-intro-tx">
      Seis servicios vertebrados sobre una idea: ningún proyecto se entrega sin
      la ingeniería resuelta. Si quieres saber qué incluye cada uno, entra al detalle.
    </p>
  </header>
  <div class="srv-grid">
    {servicios.map((s, i) => (
      <a href={`/servicios/${s.id}`} class="srv-c" data-hover>
        <p class="srv-n">— 0{i+1}</p>
        <h3 class="srv-tt">{s.title}</h3>
        <p class="srv-d">{s.description}</p>
        <span class="srv-a">Saber más ↗</span>
      </a>
    ))}
  </div>
</section>

<!-- ===== CONTACTO ===== -->
<section class="cta" id="contacto">
  <div class="cta-inner">
    <p class="kicker kicker-on-dark">05 · Contacto</p>
    <h2 class="display-2 cta-h">
      <span>¿Empezamos</span><br/>
      <em>cuando</em> <span>tú digas?</span>
    </h2>
    <p class="cta-lede">
      Una idea a medio gas ya es un proyecto. Escríbeme o llámame, y quedamos
      en Yécora, Logroño o donde te pille mejor. Sin compromiso.
    </p>
    <div class="cta-actions">
      <a href={`mailto:${site.email}`} class="btn-pri">Escribir · {site.email}</a>
      <a href={`tel:${SITE.phoneRaw}`} class="btn-ghost on-dark">Llamar · {telefono}</a>
      <a href="https://wa.me/34637869890" target="_blank" rel="noopener" class="btn-ghost on-dark">WhatsApp ↗</a>
    </div>
    <dl class="cta-info">
      <div><dt>Estudio</dt><dd>{SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}</dd></div>
      <div><dt>Email</dt><dd>{site.email}</dd></div>
      <div><dt>Teléfono</dt><dd>{telefono}</dd></div>
      <div><dt>Ámbito</dt><dd>Álava · La Rioja · País Vasco</dd></div>
      <div><dt>LinkedIn</dt><dd><a href={SITE.social.linkedin} target="_blank" rel="noopener">María Iturbe Sánchez ↗</a></dd></div>
    </dl>
  </div>
</section>

<footer class="foot">
  <div class="foot-inner">
    <div class="foot-brand">
      <p class="foot-m">mit <em>interiorismo</em> — {year} · Yécora, Álava</p>
      <p class="foot-s">Diseñado en territorio. Construido con planos, normativa y obra.</p>
    </div>
    <ul class="foot-links">
      <li><a href="/proyectos">Proyectos</a></li>
      <li><a href="/sobre">Estudio</a></li>
      <li><a href="/servicios/reforma-integral">Servicios</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
    <ul class="foot-links foot-legal">
      <li><a href="/aviso-legal">Aviso legal</a></li>
      <li><a href="/privacidad">Privacidad</a></li>
      <li><a href="/cookies">Cookies</a></li>
    </ul>
  </div>
</footer>

</main>

<script is:inline>
// body ready
(function(){
  function go(){ document.body.classList.add('is-loaded'); }
  if (document.readyState === 'complete') go();
  else { window.addEventListener('load', go, {once:true}); }
  setTimeout(go, 500);
})();

// progress bar
(function(){
  var p = document.getElementById('prog');
  function upd(){
    var h = document.documentElement.scrollHeight - window.innerHeight;
    if (h > 0 && p) p.style.width = (window.scrollY / h * 100) + '%';
  }
  window.addEventListener('scroll', upd, {passive:true});
  upd();
})();

// nav scroll state
(function(){
  var nav = document.getElementById('nav');
  function upd(){
    if (window.scrollY > 60) {
      if (nav) nav.classList.add('is-scrolled');
    } else {
      if (nav) nav.classList.remove('is-scrolled');
    }
  }
  window.addEventListener('scroll', upd, {passive:true});
  upd();
})();

// reveal + works activation
(function(){
  function splitTitle(h){
    if (!h || h.dataset.split) return;
    h.dataset.split = '1';
    var t = h.textContent || '';
    h.innerHTML = t.split(' ').map(function(w, i){
      return '<span class="wt-w" style="transition-delay:'+(i*50)+'ms"><span class="wt-i">'+w+'</span></span>';
    }).join(' ');
  }
  function activate(el){
    el.classList.add('in');
    splitTitle(el.querySelector('.work-title'));
  }
  if (!('IntersectionObserver' in window)) {
    document.querySelectorAll('.work,.reveal').forEach(activate);
    return;
  }
  setTimeout(function(){ document.querySelectorAll('.work:not(.in),.reveal:not(.in)').forEach(activate); }, 5000);
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { activate(e.target); io.unobserve(e.target); }
    });
  }, {threshold: 0.05, rootMargin: '0px 0px -50px 0px'});
  document.querySelectorAll('.work,.reveal').forEach(function(el){ io.observe(el); });
})();

// hero morph animation (wireframe → photo) — REMOVIDO 2 jul 2026
// (Santi decidió que el morph no comunicaba la transformación.
// Reemplazado por hero estático con imagen + texto + CTA. Ver hero-static.css.)

<!-- ChatBot embebido -->
<ChatBot />

</body>
</html>
