<script is:inline>
(function(){
  // HERO · AUTOPLAY + botones I·II·III·IV
  // · ciclo completo ~10s: cada fase dura 2.5s, crossfade suave de 2s
  // · pulsar un botón salta a esa fase y reinicia el ciclo
  const stage = document.getElementById('hero-morph-stage');
  if (!stage) return;
  const layers = Array.from(stage.querySelectorAll('.hero-morph-layer'));
  const steps  = Array.from(document.querySelectorAll('#hero-morph-foot .mf-step'));
  const N = layers.length;
  if (N === 0) return;
  const PHASE_MS = 2500;  // 2.5s por fase → ciclo de 10s con las 4
  // crossfade suave de 2s (ease-in-out), inyectado desde aquí para tenerlo junto al resto
  const style = document.createElement('style');
  style.textContent = '.hero-morph-layer{transition:opacity 2s ease-in-out;}';
  document.head.appendChild(style);

  let idx = 0;
  function show(i){
    for (let k = 0; k < N; k++) layers[k].style.opacity = k === i ? '1' : '0';
    steps.forEach((s, k) => s.classList.toggle('is-active', k === i));
    idx = i;
  }
  show(0);

  let timer = setInterval(() => show((idx + 1) % N), PHASE_MS);

  steps.forEach((s, k) => s.addEventListener('click', () => {
    if (k === idx) return;
    clearInterval(timer);          // evita que el ciclo pise el salto manual
    show(k);
    timer = setInterval(() => show((idx + 1) % N), PHASE_MS);  // reanuda desde la nueva fase
  }));
})();
</script>

