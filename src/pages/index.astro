<script is:inline>
(function(){
  // HERO · SCRUB por arrastre + botones de fase + teclado
  // · Progreso 0-100 → 4 capas: opacidad por tramos + micro-zoom 1.06→1.
  // · El arrastre en vivo sigue el dedo/ratón; al soltar, snap a la fase más cercana.
  // · HOOK VÍDEO IA (pendiente de María): si una capa incluye data-video-src,
  //   sustituir su <img> por <video muted playsinline loop> y en vez de opacidad
  //   controlar video.currentTime = (progreso local) * duration.
  const stage = document.getElementById('hero-morph-stage');
  if (!stage) return;
  const layers = Array.from(stage.querySelectorAll('.hero-morph-layer'));
  const steps  = Array.from(document.querySelectorAll('#hero-morph-foot .mf-step'));
  const lines  = document.querySelectorAll('.hero-morph-title .hm-line > span');
  const N = layers.length;
  if (!N) return;
  const SEG = 100 / (N - 1); // 33.33 por fase
  const clamp = (v) => Math.max(0, Math.min(100, v));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function apply(p){
    for (let k = 0; k < N; k++){
      const dist = Math.abs(p - k * SEG) / SEG;
      const o = Math.max(0, 1 - dist);
      layers[k].style.opacity = o.toFixed(3);
      const img = layers[k].querySelector('img');
      if (img) img.style.transform = 'scale(' + (1.06 - 0.06 * o).toFixed(4) + ')';
    }
    const near = Math.min(N - 1, Math.max(0, Math.round(p / SEG)));
    steps.forEach((s, k) => s.classList.toggle('is-active', k === near));
    stage.setAttribute('aria-valuenow', String(Math.round(p)));
  }

  let target = 0, current = 0;
  const setTarget = (v) => {
    target = clamp(v);
    if (reduced) apply(target); // sin interpolación
  };

  if (!reduced) {
    const tick = () => {
      current += (target - current) * 0.14;
      if (Math.abs(target - current) < 0.05) current = target;
      apply(current);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  apply(0);

  // arrastre (mouse + touch): en vivo sigue la mano, al soltar hace snap a fase
  let dragging = false, x0 = 0, t0 = 0;
  const x = (e) => (e.touches ? e.touches[0].clientX : e.clientX);
  const down = (e) => { dragging = true; x0 = x(e); t0 = target; stage.classList.add('is-dragging'); };
  const move = (e) => { if (dragging) setTarget(t0 + (x(e) - x0) / stage.clientWidth * 140); };
  const up = () => { if (!dragging) return; dragging = false; stage.classList.remove('is-dragging'); setTarget(Math.round(target / SEG) * SEG); };
  stage.addEventListener('mousedown', down);
  window.addEventListener('mousemove', move);
  window.addEventListener('mouseup', up);
  stage.addEventListener('touchstart', down, { passive: true });
  stage.addEventListener('touchmove', move, { passive: true });
  stage.addEventListener('touchend', up);
  stage.addEventListener('dragstart', (e) => e.preventDefault());

  // botones de fase (glide cinematográfico vía lerp)
  steps.forEach((s, k) => s.addEventListener('click', () => setTarget(k * SEG)));

  // teclado: la stage es un slider accesible
  stage.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { setTarget(target + SEG); e.preventDefault(); }
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { setTarget(target - SEG); e.preventDefault(); }
    else if (e.key === 'Home') { setTarget(0); e.preventDefault(); }
    else if (e.key === 'End') { setTarget(100); e.preventDefault(); }
  });

  // título: reveal escalonado (estado inicial aplicado por JS → si no hay JS, se ve)
  lines.forEach((s) => { s.style.transform = 'translateY(112%)'; });
  const revealTitle = () => {
    lines.forEach((s, i) => {
      s.style.transition = 'transform 1.05s cubic-bezier(.2,.8,.2,1) ' + (0.3 + i * 0.16).toFixed(2) + 's';
      s.style.transform = 'translateY(0)';
    });
  };
  if (document.readyState !== 'loading') requestAnimationFrame(revealTitle);
  else document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(revealTitle));
})();
</script>

